{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/ai/chat", "destination": "/api/index" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/index", "schedule": "0 0 * * *" }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "lib/**"
    }
  }
}
