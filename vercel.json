{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "find api -type f ! -name 'index.js' -delete 2>/dev/null; find api -mindepth 1 -type d -exec rm -rf {} + 2>/dev/null; npm install",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/ai/chat", "destination": "/api/index" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/cron/cleanup", "schedule": "0 0 * * *" }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "lib/**"
    }
  }
}
