{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/ai/chat",    "destination": "/api/index" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/cron/cleanup", "schedule": "0 0 * * *" },
    { "path": "/api/cron/photos", "schedule": "52 5 * * *" },
    { "path": "/api/cron/generate", "schedule": "53 5 * * *" }
  ],
  "functions": {
    "api/index.js": { "includeFiles": "lib/**", "maxDuration": 300 }
  }
}
